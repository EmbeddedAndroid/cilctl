def c_release(cfg, api, a):
    i = lease_id(a[0] if a else None)
    # DELETE tears the guest down before it answers: released, or failed
    # for a lease that had already failed (its leftovers are cleaned too).
    # A frontend proxy may give up on a slow teardown with a 504 page while
    # the lease stays up, so a gateway error is checked and the DELETE retried.
    for n in range(RELEASE_TRIES):
        code, d = api.call("DELETE", "/leases/%d" % i, timeout=300)
        if d is not None and code not in (502, 503, 504):
            break
        _, g = api.call("GET", "/leases/%d" % i)
        s = g.get("status") if isinstance(g, dict) else None
        print("%s: DELETE lease %d: HTTP %d, lease %s" % (PROG, i, code, s), file=sys.stderr)
        if s in ("released", "failed"):
            d = {"status": s}
            break
        if n + 1 < RELEASE_TRIES:
            time.sleep(RELEASE_WAIT_S)
    else:
        print("%s: lease %d is still %s; %s again later" % (PROG, i, s, cfg.hint("release %d", i)), file=sys.stderr)
        return 1
    s = d.get("status") if isinstance(d, dict) else None
    if isinstance(d, dict) and "detail" in d and "id" not in d:
        print("error: %s" % json.dumps(d["detail"])[:300], file=sys.stderr)
    print("status=%s" % s)
    if s in ("released", "failed"):
        cfg.drop(i)
        return 0
    return 1


