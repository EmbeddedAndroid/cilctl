# Runs in the guest as the lease user (bash -s), after the variable
# assignments setup_script puts in front. Idempotent: every step checks
# what is already there.
SETUP_SH = r'''
set -euo pipefail
say() { echo "setup: $*"; }
fail() { echo "setup: FAIL: $*" >&2; exit 1; }

model_stamp() { echo "$2 $(stat -c '%s %Y' "$1")"; }

# fetch_model URL SHA NOPROXY DEST NEED_MB: DEST checked against SHA,
# fetched when missing or wrong; NOPROXY (a host) bypasses the guest's proxy
fetch_model() {
	local url=$1 sha=$2 noproxy=$3 m=$4 need=$5 avail t0 got
	if [ -f "$m" ] && [ "$(cat "$m.ok" 2>/dev/null)" = "$(model_stamp "$m" "$sha")" ]; then
		say "model present ($m)"
		return 0
	fi
	if [ -f "$m" ]; then
		say "checking $m"
		[ "$(sha256sum "$m" | cut -d' ' -f1)" = "$sha" ] || { say "sha mismatch, fetching again"; rm -f "$m"; }
	fi
	if [ ! -f "$m" ]; then
		mkdir -p "${m%/*}"
		avail=$(df -Pm "${m%/*}" | awk 'NR == 2 {print $4}')
		[ "$avail" -ge "$need" ] || fail "${avail} MB free in ${m%/*}; the recipe needs ${need} MB (lease a bigger --disk)"
		say "fetching $url"
		t0=$(date +%s)
		# a rerun resumes the .part; 33 = the server does not do ranges
		curl -fL --retry 3 -C - ${noproxy:+--noproxy "$noproxy"} -sS -o "$m.part" "$url" ||
			{ [ $? != 33 ] || rm -f "$m.part"; fail "model download failed"; }
		got=$(sha256sum "$m.part" | cut -d' ' -f1)
		[ "$got" = "$sha" ] || { rm -f "$m.part"; fail "model sha256 $got, expected $sha"; }
		mv "$m.part" "$m"
		say "model fetched in $(( $(date +%s) - t0 )) s, sha256 ok"
	fi
	model_stamp "$m" "$sha" > "$m.ok"
}

# put PATH [MODE] < CONTENT: install with sudo if it differs; 0 if changed
put() {
	local t; t=$(mktemp)
	cat > "$t"
	if sudo cmp -s "$t" "$1"; then rm -f "$t"; return 1; fi
	sudo install -m "${2:-0644}" "$t" "$1" || { rm -f "$t"; fail "cannot write $1"; }
	rm -f "$t"
}

# write_service MODEL USER: cilctl-llama.service, its runner and its
# settings; 0 if any changed. Settings: ALIAS CTX ARGS ENV_SCRIPT TITLE.
write_service() {
	local c=1 unit
	put /etc/default/cilctl-llama <<EOF && c=0 || true
# cilctl-llama.service settings; restart the service after editing
MODEL=$1
CTX=$CTX
ALIAS=$ALIAS
ARGS=$ARGS
ENV_SCRIPT=$ENV_SCRIPT
EOF
	put /usr/local/bin/cilctl-llama 0755 <<EOF && c=0 || true
#!/bin/bash
# llama-server with the settings in /etc/default/cilctl-llama
set -e
[ -z "\${ENV_SCRIPT:-}" ] || . "\$ENV_SCRIPT"
exec llama-server -m "\$MODEL" -c "\$CTX" --alias "\$ALIAS" --jinja --host 127.0.0.1 --port $PORT \$ARGS
EOF
	unit=$(cat <<'EOF'
[Unit]
Description=llama-server: @TITLE@ (127.0.0.1:@PORT@)
After=network-online.target cloud-final.service
Wants=network-online.target

[Service]
User=@USER@
EnvironmentFile=/etc/default/cilctl-llama
ExecStart=/usr/local/bin/cilctl-llama
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
EOF
)
	unit=${unit/@USER@/$2}
	unit=${unit/@TITLE@/$TITLE}
	put /etc/systemd/system/cilctl-llama.service <<< "${unit/@PORT@/$PORT}" && c=0 || true
	return $c
}

# oc_install URL SHA: OpenCode into ~/.opencode/bin
oc_install() {
	local oc=$HOME/.opencode/bin/opencode t
	if [ -x "$oc" ] && [ "$(sha256sum "$oc" | cut -d' ' -f1)" = "$2" ]; then
		say "opencode present ($("$oc" --version))"
		return 0
	fi
	say "fetching $1"
	t=$(mktemp -d)
	curl -fL --retry 3 -sS -o "$t/oc.tar.gz" "$1" || { rm -rf "$t"; fail "opencode download failed"; }
	tar -xzf "$t/oc.tar.gz" -C "$t" || { rm -rf "$t"; fail "opencode tarball broken"; }
	[ "$(sha256sum "$t/opencode" | cut -d' ' -f1)" = "$2" ] || { rm -rf "$t"; fail "opencode sha256 mismatch"; }
	mkdir -p "${oc%/*}"
	install -m 0755 "$t/opencode" "$oc"
	rm -rf "$t"
	say "opencode $("$oc" --version) installed"
}

# oc_config: write $OC_JSON as the OpenCode config. Replaced only when
# missing, from before cilctl (kept as .cilctl-bak) or equal to what
# cilctl wrote last; an edited one is kept.
oc_config() {
	local c=$HOME/.config/opencode/opencode.json t
	local l=$c.cilctl-last
	mkdir -p "${c%/*}"
	t=$(mktemp)
	printf '%s\n' "$OC_JSON" > "$t"
	if cmp -s "$t" "$c"; then
		mv "$t" "$l"
	elif [ ! -f "$c" ] || [ ! -f "$l" ] || cmp -s "$c" "$l"; then
		[ ! -f "$c" ] || [ -f "$l" ] || cp "$c" "$c.cilctl-bak"
		cp "$t" "$l"
		mv "$t" "$c"
		say "wrote $c"
	else
		mv "$t" "$c.cilctl-new"
		say "kept your edited $c; cilctl's is $c.cilctl-new"
	fi
}

wait_health() {
	local i h
	say "waiting for llama-server /health"
	for i in $(seq 180); do
		h=$(curl -s --noproxy '*' -m 5 "http://127.0.0.1:$PORT/health" || true)
		case $h in *'"ok"'*) break ;; esac
		if [ "$i" = 180 ]; then
			sudo journalctl -u cilctl-llama.service -n 20 --no-pager >&2 || true
			fail "llama-server not healthy after 15 min"
		fi
		sleep 5
	done
	say "llama-server healthy"
}

