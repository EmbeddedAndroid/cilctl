LEASE_FIELDS = ["id", "status", "requester", "host_id", "image", "cpu", "ram_mb", "expires_at"]


def c_leases(cfg, api, a):
    # The whole history carries every lease's key and grows without bound
    # (770 KB on a busy CIL, cut off in transit), so ask per live status;
    # the status check also covers a CIL that ignores the filter.
    if a == ["--all"]:
        return show(api.json("GET", "/leases"), LEASE_FIELDS)
    if a:
        die("usage: leases [--all]")
    seen = {}
    for st in LIVE:
        d = api.json("GET", "/leases?status_=" + st)
        api_error(d)
        for o in d if isinstance(d, list) else []:
            if isinstance(o, dict) and o.get("status") == st:
                seen[o.get("id")] = o
    show([seen[k] for k in sorted(seen, key=lambda i: -(i or 0))], LEASE_FIELDS)


def lease_body(requester, image, cpu, ram, disk, ttl, npus):
    """Checked fields of a lease request; pool and image are added by
    post_lease."""
    if not SLUG.match(requester):
        die("requester: lower-case kebab slug")
    if image is not None and not IMAGE.match(image):
        die("image: bad name")
    v = {}
    for k, x in (("cpu", cpu), ("ram_mb", ram), ("disk_gb", disk), ("ttl_min", ttl), ("npus", npus)):
        v[k] = num(str(x), {"ram_mb": "ram", "disk_gb": "disk", "ttl_min": "ttl"}.get(k, k))
    b = {"requester": requester, "image": image, "cpu": v["cpu"], "ram_mb": v["ram_mb"],
         "disk_gb": v["disk_gb"], "ttl_min": v["ttl_min"]}
    if v["npus"]:
        b["npus"] = v["npus"]
    return b


