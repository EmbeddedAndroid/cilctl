def scp_argv(cfg, i, paths):
    if len(paths) < 2:
        die("copy <id> SRC... DST (lease paths start with ':', e.g. copy 7 a.txt : or copy 7 :out.log .)")
    d, u, h, p = conn(cfg, i)
    src, dst = paths[:-1], paths[-1]
    up = dst.startswith(":")
    if any(s.startswith(":") == up for s in src):
        die("copy: either every SRC is on the lease (':path') and DST is local, or the reverse")
    for x in paths:
        if x.lstrip(":").startswith("-"):
            die("copy: paths must not start with '-'")
    r = lambda x: "%s@%s:%s" % (u, h, x[1:])
    # scp reads a relative local "a:b" as host a
    loc = lambda x: "./" + x if ":" in x.split("/")[0] and not os.path.isabs(x) else x
    a = [cfg.scp, "-r"] + ssh_opts(cfg, d, "-P", p)
    return a + ([loc(s) for s in src] + [r(dst)] if up else [r(s) for s in src] + [loc(dst)])


