def opencode_json(r):
    m = {"name": r["title"], "tool_call": True, "reasoning": r["reasoning"],
         "limit": {"context": r["context"], "output": r["output"]}}
    c = {"$schema": "https://opencode.ai/config.json", "model": "llamacpp/" + r["alias"],
         "small_model": "llamacpp/" + r["alias"], "autoupdate": False,
         "provider": {"llamacpp": {"npm": "@ai-sdk/openai-compatible", "name": "llama.cpp (cilctl)",
                                   "options": {"baseURL": "http://127.0.0.1:%d/v1" % LLAMA_PORT, "timeout": False,
                                               "headerTimeout": 1800000, "chunkTimeout": 1800000},
                                   "models": {r["alias"]: m}}}}
    return json.dumps(c, indent=2)


def setup_script(r):
    """SETUP_SH with the recipe's settings assigned in front."""
    v = {"MODEL_URL": r["model_url"], "MODEL_SHA256": r["model_sha256"],
         "NOPROXY": urllib.parse.urlsplit(r["model_url"]).hostname if r["model_direct"] else "", "FREE_MB": str(r["free_mb"]),
         "ALIAS": r["alias"], "TITLE": r["title"], "CTX": str(r["context"]), "ARGS": r["server_args"],
         "ENV_SCRIPT": r["env_script"], "PRECHECK": r["precheck"], "PORT": str(LLAMA_PORT),
         "OC_URL": r.get("opencode_url", OC_URL), "OC_SHA": r.get("opencode_sha256", OC_SHA),
         "OC_JSON": opencode_json(r)}
    return "".join("%s=%s\n" % (k, shlex.quote(x)) for k, x in v.items()) + SETUP_SH


def setup(cfg, i, name):
    r = cfg.recipe(name)
    return run_tool(ssh_argv(cfg, i, "bash -s"), stdin=setup_script(r).encode(), replace=False)


def c_setup(cfg, api, a):
    if len(a) != 2:
        die("setup <id> RECIPE")
    i = lease_id(a[0])
    rc = setup(cfg, i, a[1])
    if rc == 0:
        print("lease %d: %s" % (i, " | ".join(cfg.hint(c, i) for c in ("opencode %d", "ssh %d opencode run 'task'",
                                                                         "forward %d"))))
    return rc


def default_name():
    u = re.sub(r"[^a-z0-9]+", "-", (os.environ.get("USER") or os.environ.get("USERNAME") or "user").lower()).strip("-")
    return "cilctl-%s" % (u or "user")


def c_up(cfg, api, a):
    o = {"name": None, "image": None, "cpu": None, "ram": None, "disk": None, "ttl": None,
         "npus": None, "setup": None}
    it = iter(a)
    for x in it:
        k, eq, v = x.partition("=")
        k = k[2:] if k.startswith("--") else None
        if k not in o:
            die("up: unknown option %r" % x)
        if not eq:
            v = next(it, None)
            if v is None:
                die("up: --%s needs a value" % k)
        o[k] = v
    base = {"npus": 0, "cpu": 2, "ram": 2048, "disk": 20, "ttl": 120}
    if o["setup"]:
        r = cfg.recipe(o["setup"])
        base = {k: r[k] for k in base}
        base["image"] = r.get("image")
    base.setdefault("image", None)
    if base["image"] is None:
        base["image"] = cfg.image
    for k in base:
        if o[k] is None:
            o[k] = base[k]
    b = lease_body(o["name"] or default_name(), o["image"], o["cpu"], o["ram"], o["disk"], o["ttl"], o["npus"])
    r = post_lease(cfg, api, b)
    i = r.get("id") if isinstance(r, dict) else None
    if not isinstance(i, int):
        return 1
    if wait(cfg, api, i):
        print("%s: lease %d is not ready; %s, then %s" % (PROG, i, cfg.hint("events %d", i), cfg.hint("release %d", i)),
              file=sys.stderr)
        return 1
    if o["setup"]:
        if setup(cfg, i, o["setup"]):
            print("%s: setup failed; the lease is kept: %s, or %s" % (PROG, cfg.hint("ssh %d", i),
                                                                       cfg.hint("release %d", i)), file=sys.stderr)
            return 1
    _, u, h, p = conn(cfg, i)
    print("lease %d ready: %s@%s port %s" % (i, u, h, p))
    hints = [("ssh %d", "shell"), ("ssh %d 'cmd'", "one command"),
             ("copy %d FILE :", "upload to ~ (:path downloads)")]
    if o["setup"]:
        hints += [("opencode %d", "OpenCode TUI"),
                  ("forward %d", "llama-server on http://127.0.0.1:%d/v1" % LLAMA_PORT)]
    hints += [("extend %d MIN", "before it expires"), ("release %d", "when done")]
    hints = [(cfg.hint(c, i), what) for c, what in hints]
    w = max(len(c) for c, _ in hints)
    for c, what in hints:
        print("  %-*s  %s" % (w, c, what))
    if cfg.cil is None:
        print("  (no profile: pass the same --url or CILCTL_URL to every command on this lease)")
    return 0


def probe_ssh(cfg, i, jump):
    a = ssh_argv(cfg, i, "true", extra=["-o", "BatchMode=yes", "-o", "ConnectTimeout=10"], jump=jump)
    try:
        r = subprocess.run(a, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                           timeout=60)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, str(e)[:200]
    err = r.stderr.decode(errors="replace").strip().splitlines()
    return r.returncode == 0, (err[-1][:200] if err else "")


def c_doctor(cfg, api, a):
    i = lease_id(a[0]) if a else None
    print("python %s on %s" % (sys.version.split()[0], sys.platform))
    for t in (cfg.ssh, cfg.scp):
        print("%s: %s" % (os.path.basename(t), shutil.which(t) or "NOT FOUND"))
    try:
        v = subprocess.run([cfg.ssh, "-V"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT).stdout
        print("ssh -V: %s" % v.decode(errors="replace").strip())
    except OSError:
        print("ssh -V: cannot run %s" % cfg.ssh)
    print("config: %s%s" % (cfg.path, "" if os.path.exists(cfg.path) else " (none)"))
    print("cil: %s (pool %s)" % (cfg.cil or "no profile", cfg.pool or "auto"))
    print("state: %s" % cfg.state)
    print("jump: %s" % (",".join(cfg.jump) or "none"))
    ok = True
    direct = api.direct_ok()
    print("api direct %s: %s" % (cfg.url, "ok" if direct else "unreachable"))
    if direct:
        api.route = "direct"
    elif cfg.jump:
        err = api.open_tunnel()
        print("api via jump: %s" % ("ok" if not err else err))
        if not err:
            api.route = "jump"
    if api.route:
        try:
            _, t = api.raw("GET", "/api/health", timeout=20)
            v = json.loads(t).get("version")
            print("api health: version %s (route %s)" % (v, api.route))
        except (ApiDown, ValueError, AttributeError) as e:
            print("api health: bad reply (%s)" % e)
            ok = False
    else:
        print("api: no route" + ("" if cfg.jump else " (set --jump, CILCTL_JUMP or the profile's jump)"))
        ok = False
    if i is not None:
        lr = []
        d, why = probe_ssh(cfg, i, [])
        print("lease %d ssh direct: %s" % (i, "ok" if d else "fail %s" % why))
        if d:
            lr.append("direct")
        if cfg.jump:
            j, why = probe_ssh(cfg, i, cfg.jump)
            print("lease %d ssh via jump: %s" % (i, "ok" if j else "fail %s" % why))
            if j:
                lr.append("jump")
        print("lease %d route: %s" % (i, ", ".join(lr) or "none"))
        ok = ok and bool(lr)
    return 0 if ok else 1


CMDS = {"cils": c_cils, "setups": c_setups, "health": c_health, "pools": c_pools, "hosts": c_hosts,
        "images": c_images, "leases": c_leases, "request": c_request, "wait": c_wait, "up": c_up,
        "setup": c_setup, "ssh": c_ssh, "opencode": c_opencode, "forward": c_forward, "copy": c_copy,
        "scp": c_copy, "apt": c_apt, "extend": c_extend, "events": c_events, "release": c_release,
        "doctor": c_doctor}
NO_URL = ("cils", "setups")


def main(argv):
    url = jump = cil = None
    while argv and argv[0].startswith("--") and argv[0] not in ("--help",):
        k, _, v = argv.pop(0).partition("=")
        if not _:
            if not argv:
                die("%s needs a value" % k)
            v = argv.pop(0)
        if k == "--url":
            url = v or die("--url needs a value")
        elif k == "--jump":
            jump = v
        elif k == "--cil":
            cil = v or die("--cil needs a name")
        else:
            die("unknown option %s" % k, 2)
    cmd = argv.pop(0) if argv else ""
    f = CMDS.get(cmd)
    if f is None:
        print(__doc__.split("\n\n", 1)[1].rstrip())
        return 0 if cmd in ("", "help", "--help", "-h") else 2
    if not WINDOWS:
        # exit through atexit, which stops the jump tunnel
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, lambda n, _: sys.exit(128 + n))
    cfg = Cfg(url, jump, cil, need_url=cmd not in NO_URL)
    try:
        r = f(cfg, Api(cfg) if cfg.url else None, argv)
    except KeyboardInterrupt:
        return 130
    return r if isinstance(r, int) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
