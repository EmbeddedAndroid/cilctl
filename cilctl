    v = list(a[1:]) + d[len(a) - 1:]
    post_lease(cfg, api, lease_body(a[0], *v))


def wait(cfg, api, i):
    """0 ready, 1 failed/released/unknown/timeout."""
    for n in range(POLL_N):
        try:
            _, t = api.raw("GET", "/api/v1/leases/%d" % i)
            d = json.loads(t)
        except (ApiDown, ValueError):
            d = None
            s = None
        else:
            s = store(cfg, i, d)
            if s is None:
                print("error: %s" % json.dumps(d.get("detail", "unexpected reply") if isinstance(d, dict)
                                               else "unexpected reply")[:300], file=sys.stderr)
                return 1
        if s is not None:
            print("%s %s" % (time.strftime("%H:%M:%S", time.gmtime()), s), flush=True)
            st = s.split()[0]
            if st in ("ready", "expiring"):
                return 0
            if st in ("failed", "released"):
                cfg.drop(i)
                return 1
        if n + 1 < POLL_N:
            time.sleep(POLL_S)
    print("%s: lease %d not ready after %d min (%s)" % (PROG, i, POLL_S * POLL_N // 60, cfg.hint("events %d", i)),
          file=sys.stderr)
    return 1


