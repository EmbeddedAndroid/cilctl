PROG = "cilctl"
WINDOWS = os.name == "nt"
POLL_S = 20
POLL_N = 90
RELEASE_TRIES = 3
RELEASE_WAIT_S = 5
REMOTE_PATH = "export PATH=$HOME/.opencode/bin:$HOME/.local/bin:$PATH; "

SLUG = re.compile(r"^[a-z0-9][a-z0-9-]*$")
IMAGE = re.compile(r"^[a-z0-9][a-z0-9.-]*$")
NUM = re.compile(r"^(0|[1-9][0-9]*)$")
URL = re.compile(r"^https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._/-]*)?$")
# lower case, a letter first (digits are lease ids in a state dir); "_" is
# kept for the state dirs of bare URLs
NAME = re.compile(r"^[a-z][a-z0-9-]*$")
RECIPE_NAME = re.compile(r"^[a-z0-9][a-z0-9-]*$")
WIN_DEVICES = {"con", "prn", "aux", "nul"} | {"%s%d" % (x, n) for x in ("com", "lpt") for n in range(1, 10)}
HOP = re.compile(r"^([A-Za-z0-9._-]+@)?[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?$")
# the lease reply goes into ssh and scp argv: no leading "-", no spaces
SSH_USER = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]*$")
SSH_HOST = re.compile(r"^[A-Za-z0-9][A-Za-z0-9.:-]*$")


def die(msg, rc=1):
    print("%s: %s" % (PROG, msg), file=sys.stderr)
    sys.exit(rc)


def num(v, what):
    if v is None or not NUM.match(v):
        die("%s must be a number" % what)
    return int(v)


def lease_id(v):
    return num(v, "id")


# ---------------------------------------------------------------- config

class TomlError(Exception):
    pass


ESC = {"b": "\b", "t": "\t", "n": "\n", "f": "\f", "r": "\r", '"': '"', "\\": "\\"}


def toml_value(v, lines, i):
    """(value, next line index) of the text after '='."""
    def tail(rest):
        if rest.strip() and not rest.strip().startswith("#"):
            raise TomlError("text after the value")

    if v.startswith("'''"):
        rest = v[3:]
        if "'''" in rest:
            tail(rest[rest.index("'''") + 3:])
            return rest[:rest.index("'''")], i
        parts = [rest] if rest else []
        while i < len(lines):
            ln = lines[i]
            i += 1
            if "'''" in ln:
                tail(ln[ln.index("'''") + 3:])
                parts.append(ln[:ln.index("'''")])
                return "\n".join(parts), i
            parts.append(ln)
        raise TomlError("unterminated '''")
    if v.startswith("'"):
        m = re.match(r"^'([^'\n]*)'(.*)$", v)
        if not m:
            raise TomlError("unterminated string")
        tail(m.group(2))
        return m.group(1), i
    if v.startswith('"'):
        if v.startswith('"""'):
            raise TomlError('""" strings are not supported; use \'\'\'')
        m = re.match(r'^"((?:[^"\\\n]|\\.)*)"(.*)$', v)
        if not m:
            raise TomlError("unterminated string")
        tail(m.group(2))

        def esc(e):
            s = e.group(1)
            if s[0] in "uU":
                return chr(int(s[1:], 16))
            return ESC[s]
        body = m.group(1)
        if re.search(r'\\(?![btnfr"\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})', body):
            raise TomlError("bad escape")
        return re.sub(r'\\(u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|.)', esc, body), i
    m = re.match(r"^([+-]?(?:0|[1-9](?:_?[0-9])*)|true|false)(\s.*)?$", v)
    if not m:
        raise TomlError("unsupported value (cilctl reads strings, integers and booleans)")
    tail(m.group(2) or "")
    t = m.group(1)
    if t in ("true", "false"):
        return t == "true", i
    return int(t.replace("_", "")), i


def parse_toml(text):
    """The TOML subset of cilctl's config: [table] and [a.b] headers,
    bare keys, "basic" and 'literal' strings, '''multi-line literal'''
    strings, integers, booleans and comments."""
    lines = text.split("\n")
    root, seen, i = {}, set(), 0
    cur = root
    while i < len(lines):
        s = lines[i].strip()
        i += 1
        try:
            if not s or s.startswith("#"):
                continue
            if s.startswith("["):
                m = re.match(r"^\[\s*([A-Za-z0-9_-]+(?:\s*\.\s*[A-Za-z0-9_-]+)*)\s*\]\s*(#.*)?$", s)
                if not m:
                    raise TomlError("bad table header")
                path = tuple(p.strip() for p in m.group(1).split("."))
                if path in seen:
                    raise TomlError("table [%s] defined twice" % ".".join(path))
                seen.add(path)
                cur = root
                for p in path:
                    cur = cur.setdefault(p, {})
                    if not isinstance(cur, dict):
                        raise TomlError("%s is a value, not a table" % p)
                continue
            m = re.match(r"^([A-Za-z0-9_-]+)\s*=\s*(.*)$", s)
            if not m:
                raise TomlError("expected key = value")
            k, v = m.groups()
            if k in cur:
                raise TomlError("key %s defined twice" % k)
            cur[k], i = toml_value(v, lines, i)
        except TomlError as e:
            raise TomlError("line %d: %s" % (i, e))
    return root


def config_path():
    p = os.environ.get("CILCTL_CONFIG")
    if p:
        return p
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "cilctl", "config.toml")


CIL_KEYS = {"url": str, "pool": str, "image": str, "jump": str}
SETUP_KEYS = {"model_url": str, "model_sha256": str, "model_direct": bool, "alias": str, "title": str, "context": int,
              "output": int, "reasoning": bool, "server_args": str, "env_script": str, "precheck": str,
              "free_mb": int, "image": str, "npus": int, "cpu": int, "ram": int, "disk": int, "ttl": int,
              "opencode_url": str, "opencode_sha256": str}
SETUP_DEFAULTS = {"model_direct": False, "output": 8192, "reasoning": False, "server_args": "", "env_script": "", "precheck": "",
                  "free_mb": 0, "npus": 0, "cpu": 4, "ram": 8192, "disk": 50, "ttl": 240}
SETUP_REQUIRED = ("model_url", "model_sha256", "alias", "context")
SHA = re.compile(r"^[0-9a-f]{64}$")
MODEL_URL = re.compile(r"^https?://[A-Za-z0-9.-]+(:[0-9]+)?/([A-Za-z0-9._~%/-]*/)?[A-Za-z0-9._-]+$")
ALIAS = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
TITLE = re.compile(r"^[A-Za-z0-9 ._()+,:/-]*$")
# written into a systemd EnvironmentFile, which would interpret quotes
ARGS = re.compile(r"^[A-Za-z0-9 ._,=:/+-]*$")
PATHNAME = re.compile(r"^(/[A-Za-z0-9._-]+)*$")


def check_table(p, kind, n, v, keys):
    if kind == "setup" and not RECIPE_NAME.match(n):
        die("%s: setup %r: a name is lower case letters, digits and '-'" % (p, n))
    if kind == "cil" and (not NAME.match(n) or n in WIN_DEVICES):
        die("%s: cil %r: a name is lower case, starts with a letter, and is not a Windows device" % (p, n))
    if not isinstance(v, dict):
        die("%s: %s.%s must be a table" % (p, kind, n))
    for k, x in v.items():
        t = keys.get(k)
        # bool is an int in Python; neither stands in for the other
        if t is None or type(x) is not t:
            die("%s: %s.%s: unknown key %r or wrong type (keys: %s)" % (p, kind, n, k, ", ".join(sorted(keys))))


def check_setup(p, n, v):
    w = "%s: setup.%s" % (p, n)
    for k in SETUP_REQUIRED:
        if k not in v:
            die("%s needs %s" % (w, k))
    v = dict(SETUP_DEFAULTS, **v)
    v.setdefault("title", v["alias"])
    for k, rx in (("model_url", MODEL_URL), ("alias", ALIAS), ("title", TITLE), ("server_args", ARGS),
                  ("env_script", PATHNAME)):
        if not rx.match(v[k]):
            die("%s: bad %s %r" % (w, k, v[k]))
    if not SHA.match(v["model_sha256"]):
        die("%s: model_sha256 is 64 lower-case hex digits" % w)
    if ("opencode_url" in v) != ("opencode_sha256" in v):
        die("%s: opencode_url and opencode_sha256 go together" % w)
    if "opencode_url" in v and (not MODEL_URL.match(v["opencode_url"]) or not SHA.match(v["opencode_sha256"])):
        die("%s: bad opencode_url or opencode_sha256" % w)
    if "image" in v and not IMAGE.match(v["image"]):
        die("%s: bad image" % w)
    for k in ("context", "output", "free_mb", "npus", "cpu", "ram", "disk", "ttl"):
        if v[k] < 0:
            die("%s: %s must not be negative" % (w, k))
    return v


def load_config():
    """(path, cils, setups, default profile or None)."""
    p = config_path()
    try:
        with open(p, encoding="utf-8-sig") as f:
            c = parse_toml(f.read())
    except FileNotFoundError:
        if os.environ.get("CILCTL_CONFIG"):
            die("%s: no such file (CILCTL_CONFIG)" % p)
        c = {}
    except (OSError, UnicodeError) as e:
        die("%s: %s" % (p, e))
    except TomlError as e:
        die("%s: %s" % (p, e))
    if set(c) - {"default", "cil", "setup"}:
        die("%s: top-level keys are default, [cil.NAME] and [setup.NAME]" % p)
    cils, setups = c.get("cil", {}), c.get("setup", {})
    if not isinstance(cils, dict) or not isinstance(setups, dict):
        die("%s: cil and setup are tables of tables" % p)
    for n, v in cils.items():
        check_table(p, "cil", n, v, CIL_KEYS)
        if "url" not in v:
            die("%s: cil.%s needs url" % (p, n))
        v["url"] = v["url"].rstrip("/")
        if not URL.match(v["url"]):
            die("%s: cil.%s: url must be http(s)://host[:port][/path]" % (p, n))
        if "pool" in v and not SLUG.match(v["pool"]) or "image" in v and not IMAGE.match(v["image"]):
            die("%s: cil.%s: bad pool or image name" % (p, n))
    for n, v in list(setups.items()):
        check_table(p, "setup", n, v, SETUP_KEYS)
        setups[n] = check_setup(p, n, v)
    d = c.get("default")
    if d is not None and (not isinstance(d, str) or d not in cils):
        die("%s: default %r is not a [cil.NAME] profile" % (p, d))
    return p, cils, setups, d


class Cfg:
    def __init__(self, url=None, jump=None, cil=None, need_url=True):
        self.path, self.cils, self.setups, default = load_config()
        jump_flag = jump is not None
        url_from = "--url" if url else None
        if not url and os.environ.get("CILCTL_URL"):
            url, url_from = os.environ["CILCTL_URL"], "CILCTL_URL"
        # an explicit URL alone means no profile, not the default one
        self.cil = cil or os.environ.get("CILCTL_CIL") or (None if url else default)
        if self.cil is not None and self.cil not in self.cils:
            die("unknown cil %r (profiles in %s: %s)" % (self.cil, self.path, ", ".join(sorted(self.cils)) or "none"))
        prof = self.cils.get(self.cil, {})
        self.url = (url or prof.get("url") or "").rstrip("/")
        if not url_from and self.cil:
            url_from = "cil.%s url" % self.cil
        if self.url and not URL.match(self.url):
            die("%s must be http(s)://host[:port][/path]" % url_from)
        if need_url and not self.url:
            die("no CIL: pass --url, set CILCTL_URL, or add a [cil.NAME] profile to %s" % self.path)
        self.pool = os.environ.get("CILCTL_POOL") or prof.get("pool")
        if self.pool and not SLUG.match(self.pool):
            die("bad pool name %r" % self.pool)
        self.image = prof.get("image")
        st = os.environ.get("CILCTL_STATE") or os.path.join(os.path.expanduser("~"), ".cache", "cilctl")
        if self.cil:
            self.name = self.cil
        else:
            # "_" never appears in a profile name, so these never collide
            self.name = "url_" + re.sub(r"[^A-Za-z0-9.-]", "_", urllib.parse.urlsplit(self.url).netloc)
        self.state = os.path.join(st, self.name)
        if jump is None:
            jump = os.environ.get("CILCTL_JUMP")
        if jump is None:
            jump = prof.get("jump", "")
        self.jump = [h for h in jump.split(",") if h] if jump != "none" else []
        for h in self.jump:
            if not HOP.match(h):
                die("jump: bad hop %r (user@host[:port],...)" % h)
        self.ssh = os.environ.get("CILCTL_SSH") or find_tool("ssh")
        self.scp = os.environ.get("CILCTL_SCP") or find_tool("scp")
        # flags the commands cilctl suggests must repeat to reach this CIL
        # the same way (environment and default profile carry over)
        again = []
        if cil:
            again += ["--cil", cil]
        if url_from == "--url":
            again += ["--url", self.url]
        if jump_flag:
            again += ["--jump", ",".join(self.jump) or "none"]
        self.cmd = " ".join([PROG] + again)

    def hint(self, fmt, *a):
        """A cilctl command line to suggest: fmt % a after the flags."""
        return "%s %s" % (self.cmd, fmt % a)

    def lease_dir(self, i):
        return os.path.join(self.state, str(i))

    def drop(self, i):
        shutil.rmtree(self.lease_dir(i), ignore_errors=True)

    def recipe(self, n):
        if n not in self.setups:
            die("unknown setup recipe %r (recipes in %s: %s)" % (n, self.path, ", ".join(sorted(self.setups)) or
                                                                 "none"))
        return self.setups[n]


def find_tool(name):
    p = shutil.which(name)
    if p:
        return p
    if WINDOWS:
        w = os.path.join(os.environ.get("SystemRoot", r"C:\Windows"), "System32", "OpenSSH", name + ".exe")
        if os.path.exists(w):
            return w
    return name


# ---------------------------------------------------------------- API

class Api:
    """CIL REST calls. When the API is not reachable directly and jump
    hops are configured, the calls go through an ssh -L tunnel to the
    last hop, which must reach the CIL itself."""

    def __init__(self, cfg):
        self.cfg = cfg
        u = urllib.parse.urlsplit(cfg.url)
        self.host = u.hostname
        self.port = u.port or (443 if u.scheme == "https" else 80)
        self.route = None
        self.tunnel = None

    def direct_ok(self, timeout=4):
        try:
            socket.create_connection((self.host, self.port), timeout).close()
            return True
        except OSError:
            return False

    def tunnel_argv(self, lport):
        hops = self.cfg.jump
        a = [self.cfg.ssh, "-N", "-o", "ExitOnForwardFailure=yes", "-o", "BatchMode=yes",
             "-o", "ConnectTimeout=10", "-L", "127.0.0.1:%d:%s:%d" % (lport, self.host, self.port)]
        if len(hops) > 1:
            a += ["-J", ",".join(hops[:-1])]
        last = hops[-1]
        m = re.match(r"^(.*):([0-9]+)$", last)
        if m:
            a += ["-p", m.group(2)]
            last = m.group(1)
        return a + [last]

    def open_tunnel(self):
        s = socket.socket()
        s.bind(("127.0.0.1", 0))
        lport = s.getsockname()[1]
        s.close()
        log = tempfile.TemporaryFile()
        p = subprocess.Popen(self.tunnel_argv(lport), stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=log)
        atexit.register(stop_proc, p)
        for _ in range(150):
            if p.poll() is not None:
                log.seek(0)
                err = log.read().decode(errors="replace").strip().splitlines()
                return "ssh tunnel via %s exited: %s" % (",".join(self.cfg.jump), (err or ["?"])[-1][:200])
            try:
                socket.create_connection(("127.0.0.1", lport), 1).close()
                break
            except OSError:
                time.sleep(0.2)
        else:
            return "ssh tunnel via %s did not come up" % ",".join(self.cfg.jump)
        self.tunnel = p
        self.opener = tunnel_opener(lport)
        return None

    def connect(self):
        if self.route:
            return
        if self.direct_ok():
            self.route = "direct"
            return
        if not self.cfg.jump:
            die("cannot reach %s (wrong network or no VPN? else set --jump, CILCTL_JUMP or the profile's "
                "jump; see %s)" % (self.cfg.url, self.cfg.hint("doctor")))
        err = self.open_tunnel()
        if err:
            die("cannot reach %s directly, and %s" % (self.cfg.url, err))
        self.route = "jump"

    # never through http_proxy: the route was probed directly, and a
    # proxy cannot reach the jump tunnel on this machine's 127.0.0.1
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

    def raw(self, method, path, body=None, timeout=60):
        """(status, text) of one call; path is relative to the URL."""
        self.connect()
        data = None
        hdr = {}
        if body is not None:
            data = json.dumps(body).encode()
            hdr["Content-Type"] = "application/json"
        req = urllib.request.Request(self.cfg.url + path, data=data, method=method, headers=hdr)
        try:
            with self.opener.open(req, timeout=timeout) as r:
                return r.status, r.read().decode(errors="replace")
        except urllib.error.HTTPError as e:
            return e.code, e.read().decode(errors="replace")
        except (urllib.error.URLError, OSError) as e:
            raise ApiDown(str(getattr(e, "reason", e)))

    def call(self, method, path, body=None, timeout=60):
        """(status, parsed JSON or None) of one /api/v1 call."""
        try:
            code, text = self.raw(method, "/api/v1" + path, body, timeout)
        except ApiDown as e:
            die("CIL unreachable: %s" % e)
        try:
            return code, json.loads(text)
        except ValueError:
            return code, None

    def json(self, method, path, body=None, timeout=60):
        code, d = self.call(method, path, body, timeout)
        if d is None:
            sys.exit("error: non-JSON reply from CIL (HTTP %d)" % code)
        return d


class ApiDown(Exception):
    pass


def tunnel_opener(lport):
    """An opener that dials the tunnel's 127.0.0.1:lport but keeps the
    URL's host for the Host header and for TLS (SNI and the certificate
    name check)."""
    ctx = ssl.create_default_context()

    class Http(http.client.HTTPConnection):
        def connect(self):
            self.sock = socket.create_connection(("127.0.0.1", lport), self.timeout)

    class Https(http.client.HTTPSConnection):
        def connect(self):
            s = socket.create_connection(("127.0.0.1", lport), self.timeout)
            self.sock = ctx.wrap_socket(s, server_hostname=self.host)

    class H(urllib.request.HTTPHandler):
        def http_open(self, req):
            return self.do_open(Http, req)

    class Hs(urllib.request.HTTPSHandler):
        def https_open(self, req):
            return self.do_open(Https, req)

    return urllib.request.build_opener(urllib.request.ProxyHandler({}), H(), Hs())


def stop_proc(p):
    if p.poll() is None:
        p.terminate()
        try:
            p.wait(5)
        except subprocess.TimeoutExpired:
            p.kill()


def api_error(d):
    if isinstance(d, dict) and "detail" in d and "id" not in d:
        sys.exit("error: %s" % json.dumps(d["detail"])[:300])


def show(d, fields):
    """Print allowlisted fields of one object or of each list element."""
    api_error(d)
    for o in d if isinstance(d, list) else [d]:
        print(" ".join("%s=%s" % (f, o.get(f)) for f in fields))


def pool_image(cfg, api, image):
    """The pool and image of a new lease: the profile's (or CILCTL_POOL),
    else the CIL's only pool and that pool's only allowed image."""
    pool = cfg.pool
    if pool and image:
        return pool, image
    ps = api.json("GET", "/pools")
    api_error(ps)
    ps = [p for p in ps if isinstance(p, dict)] if isinstance(ps, list) else []
    if not pool:
        names = [p.get("name") for p in ps]
        if len(names) != 1:
            die("the CIL has pools %s: set pool in the profile or CILCTL_POOL" % (", ".join(map(str, names)) or
                                                                                  "none"))
        pool = names[0]
        if not isinstance(pool, str) or not SLUG.match(pool):
            die("the CIL's pool name %r is not usable" % pool)
    if not image:
        imgs = [p.get("allowed_images") for p in ps if p.get("name") == pool]
        imgs = imgs[0] if imgs and isinstance(imgs[0], list) else []
        if len(imgs) != 1:
            die("pool %s allows %s: pick one with --image (or image in the profile)" % (
                pool, ", ".join(map(str, imgs)) or "no listed image"))
        image = imgs[0]
    return pool, image


# ---------------------------------------------------------------- keys

def restrict_windows(path):
    # The SID of the process token: USERNAME/USERDOMAIN can be stale or
    # unset (runas, services, a changed profile) and then match no account.
    r = subprocess.run(["whoami", "/user", "/fo", "csv", "/nh"], stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT)
    sid = r.stdout.decode(errors="replace").strip().split(",")[-1].strip('"')
    if r.returncode or not sid.startswith("S-"):
        raise OSError("whoami /user: %s" % r.stdout.decode(errors="replace").strip()[:200])
    # Some images give new files explicit SYSTEM, Administrators and
    # OWNER RIGHTS entries, which /inheritance:r keeps: drop them too.
    for args in (["/inheritance:r", "/grant:r", "*%s:F" % sid],
                 ["/remove:g", "*S-1-5-18", "*S-1-5-32-544", "*S-1-3-4"]):
        r = subprocess.run(["icacls", path] + args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        if r.returncode:
            raise OSError("icacls: %s" % r.stdout.decode(errors="replace").strip()[:200])


def store(cfg, i, d):
    """Write the key and connection of a ready lease; return a status line
    with allowlisted fields only. None for a reply that is not a lease."""
    if not isinstance(d, dict) or "status" not in d:
        return None
    c = d.get("connection") or {}
    if d["status"] in ("ready", "expiring") and c.get("private_key_pem"):
        u, h, p = (str(x or "") for x in (c.get("user"), c.get("fwd_host") or c.get("host"),
                                          c.get("fwd_port") or c.get("port")))
        if not (SSH_USER.match(u) and SSH_HOST.match(h) and NUM.match(p) and 0 < int(p) < 65536):
            die("lease %d: the CIL sent a bad ssh user, host or port; key not kept (%s)"
                % (i, cfg.hint("release %d", i)))
        st = cfg.lease_dir(i)
        os.makedirs(st, mode=0o700, exist_ok=True)
        key = os.path.join(st, "key")
        if os.path.exists(key):
            # an old key may be read-only (0400, the Windows attribute)
            os.chmod(key, 0o600)
            os.unlink(key)
        fd = os.open(key, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        if WINDOWS:
            # narrowed while still empty: the state dir's ACL is inherited
            try:
                restrict_windows(key)
            except OSError as e:
                os.close(fd)
                os.unlink(key)
                die("cannot restrict the key to this user (%s); key not kept" % e)
        os.write(fd, c["private_key_pem"].encode())
        os.close(fd)
        with open(os.path.join(st, "conn"), "w") as f:
            f.write("%s %s %s\n" % (u, h, p))
    s = "%s host_id=%s expires_at=%s" % (d["status"], d.get("host_id"), d.get("expires_at"))
    if d.get("last_error"):
        s += " last_error=%s" % d["last_error"][:200]
    return s


def conn(cfg, i):
    d = cfg.lease_dir(i)
    try:
        with open(os.path.join(d, "conn")) as f:
            u, h, p = f.read().split()
    except (OSError, ValueError):
        die("no key for lease %d on %s (run: %s)" % (i, cfg.name, cfg.hint("wait %d", i)))
    return d, u, h, p


def ssh_opts(cfg, d, port_flag, port, jump=None):
    o = ["-i", os.path.join(d, "key"), port_flag, port, "-o", "IdentitiesOnly=yes",
         "-o", "StrictHostKeyChecking=accept-new",
         # quoted for paths with spaces; ssh's option parser eats backslashes
         "-o", 'UserKnownHostsFile="%s"' % os.path.join(d, "known_hosts").replace("\\", "/"),
         "-o", "ServerAliveInterval=30"]
    jump = cfg.jump if jump is None else jump
    if jump:
        o += ["-o", "ProxyJump=%s" % ",".join(jump)]
    return o


def ssh_argv(cfg, i, remote=None, tty=False, extra=(), jump=None):
    d, u, h, p = conn(cfg, i)
    a = [cfg.ssh] + ssh_opts(cfg, d, "-p", p, jump) + list(extra)
    if tty:
        a.append("-t")
    a.append("%s@%s" % (u, h))
    if remote is not None:
        a.append(remote)
    return a


def remote_line(args):
    """One argument is a shell line, several are a command and its
    arguments; either way ~/.opencode/bin and ~/.local/bin are on PATH,
    which a non-interactive ssh shell would not set."""
    if not args:
        return None
    line = args[0] if len(args) == 1 else " ".join(shlex.quote(a) for a in args)
    return REMOTE_PATH + line


def run_tool(argv, stdin=None, replace=True):
    """Run ssh/scp. On POSIX the process is replaced (tty and signals go
    to ssh); Windows has no real exec, so wait and pass the exit code."""
    if replace and stdin is None and not WINDOWS:
        sys.stdout.flush()
        sys.stderr.flush()
        try:
            os.execvp(argv[0], argv)
        except OSError as e:
            die("cannot run %s: %s" % (argv[0], e))
    try:
        r = subprocess.run(argv, input=stdin)
    except OSError as e:
        die("cannot run %s: %s" % (argv[0], e))
    return r.returncode


def isatty():
    return sys.stdin.isatty() and sys.stdout.isatty()


